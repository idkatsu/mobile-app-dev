<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#121220"/>
    <SolidColorBrush x:Key="AppForeground" Color="#E0E0F0"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="SidebarForeground" Color="#A0A0C0"/>
    <SolidColorBrush x:Key="CardBackground" Color="#1E1E32"/>
    <SolidColorBrush x:Key="ColumnBackground" Color="#16162A"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#2A2A42"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#C0C0E0"/>
    <SolidColorBrush x:Key="AccentColor" Color="#42A5F5"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#333350"/>
    <SolidColorBrush x:Key="DangerColor" Color="#EF5350"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#66BB6A"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFA726"/>

</ResourceDictionary>
