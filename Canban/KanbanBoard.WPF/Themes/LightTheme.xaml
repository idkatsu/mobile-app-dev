<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="AppForeground" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarForeground" Color="#4A4A6A"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColumnBackground" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#E8ECF1"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#2D2D44"/>
    <SolidColorBrush x:Key="AccentColor" Color="#2196F3"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#DDE1E8"/>
    <SolidColorBrush x:Key="DangerColor" Color="#F44336"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FF9800"/>

</ResourceDictionary>
