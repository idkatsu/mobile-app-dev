<UserControl x:Class="KanbanBoard.WPF.Views.SprintBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="Спринты" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"/>
                <Button Content="&#x2795; Новый спринт" Click="NewSprint_Click" Padding="12,6"
                        HorizontalAlignment="Right" Background="{DynamicResource AccentColor}"
                        Foreground="{DynamicResource AccentForeground}" FontWeight="SemiBold" FontSize="13"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sprints}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="16,12"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="Старт" Click="StartSprint_Click" Tag="{Binding Id}" Padding="10,4" Margin="0,0,6,0"
                                            FontSize="11" Background="{DynamicResource SuccessColor}" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"
                                            Visibility="{Binding Status, Converter={StaticResource SprintStatusToStartVisibility}}"/>
                                    <Button Content="Удалить" Click="DeleteSprint_Click" Tag="{Binding Id}" Padding="10,4"
                                            FontSize="11" Background="{DynamicResource DangerColor}" Foreground="White"
                                            BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppForeground}"/>
                                        <Border Padding="6,2" Margin="8,0,0,0" CornerRadius="4"
                                                Background="{DynamicResource ButtonBackground}">
                                            <TextBlock Text="{Binding Status}" FontSize="11"
                                                       Foreground="{DynamicResource SidebarForeground}"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Goal}" FontSize="12" Margin="0,0,0,6"
                                               Foreground="{DynamicResource SidebarForeground}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource SidebarForeground}"
                                                   Text="{Binding StartDate, StringFormat='{}{0:dd.MM}'}"/>
                                        <ProgressBar Grid.Column="1" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="8,0"
                                                     Foreground="{DynamicResource AccentColor}" Background="{DynamicResource ButtonBackground}"/>
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource SidebarForeground}"
                                                   Text="{Binding EndDate, StringFormat='{}{0:dd.MM}'}"/>
                                    </Grid>
                                    <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource SidebarForeground}">
                                        <Run Text="{Binding DaysElapsed, Mode=OneWay}"/>
                                        <Run Text=" из "/>
                                        <Run Text="{Binding TotalDays, Mode=OneWay}"/>
                                        <Run Text=" дней"/>
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
