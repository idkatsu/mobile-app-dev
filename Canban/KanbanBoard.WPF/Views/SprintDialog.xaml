<Window x:Class="KanbanBoard.WPF.Views.SprintDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый спринт" Width="400" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">
    <StackPanel Margin="20">
        <TextBlock Text="Название" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Height="30" FontSize="14" Margin="0,0,0,12"
                 Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource AppForeground}"
                 BorderBrush="{DynamicResource BorderColor}"/>

        <TextBlock Text="Цель спринта" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
        <TextBox x:Name="GoalBox" Height="30" FontSize="13" Margin="0,0,0,12"
                 Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource AppForeground}"
                 BorderBrush="{DynamicResource BorderColor}"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Начало" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
                <DatePicker x:Name="StartDate" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Конец" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
                <DatePicker x:Name="EndDate" FontSize="13"/>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Создать" Click="Ok_Click" Padding="16,8" Margin="0,0,8,0"
                    Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}" FontWeight="SemiBold"/>
            <Button Content="Отмена" Click="Cancel_Click" Padding="16,8"
                    Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
        </StackPanel>
    </StackPanel>
</Window>
