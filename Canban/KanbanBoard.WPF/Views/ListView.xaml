<UserControl x:Class="KanbanBoard.WPF.Views.ListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Padding="12,10" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchBox" Width="200" Height="30" FontSize="13" Margin="0,0,8,0"
                         VerticalContentAlignment="Center" Background="{DynamicResource ButtonBackground}"
                         Foreground="{DynamicResource AppForeground}" BorderBrush="{DynamicResource BorderColor}"
                         TextChanged="SearchBox_TextChanged"/>
                <ComboBox x:Name="FilterPriority" Width="140" Height="30" Margin="0,0,8,0"
                          VerticalContentAlignment="Center"
                          SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="Все приоритеты" IsSelected="True" Tag="All"/>
                    <ComboBoxItem Content="Критический" Tag="Critical"/>
                    <ComboBoxItem Content="Высокий" Tag="High"/>
                    <ComboBoxItem Content="Средний" Tag="Medium"/>
                    <ComboBoxItem Content="Низкий" Tag="Low"/>
                </ComboBox>
                <Button Content="&#x2795; Задача" Click="AddTask_Click" Padding="12,6"
                        Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}" FontSize="13"/>
            </StackPanel>
        </Border>
        <DataGrid x:Name="TaskGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  ItemsSource="{Binding ListTasks}"
                  Background="{DynamicResource CardBackground}" Foreground="{DynamicResource AppForeground}"
                  BorderBrush="{DynamicResource BorderColor}" CanUserAddRows="False"
                  SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" AlternatingRowBackground="{DynamicResource ColumnBackground}"
                  RowHeight="32" ColumnHeaderHeight="32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="90"/>
                <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Колонка" Binding="{Binding ColumnName}" Width="110"/>
                <DataGridTextColumn Header="Метка" Binding="{Binding Label}" Width="90"/>
                <DataGridTextColumn Header="Дедлайн" Binding="{Binding DeadlineText}" Width="90"/>
                <DataGridTextColumn Header="Помидоры" Binding="{Binding PomodoroText}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
