<Window x:Class="KanbanBoard.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KanbanBoard.WPF.Views"
        Title="Канбан-доска + Pomodoro"
        Width="1200" Height="700"
        MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarForeground}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ButtonBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Канбан" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="+ Pomodoro" FontSize="13"
                               Foreground="{DynamicResource SidebarForeground}"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Button Content="&#x1F4CB; Канбан-доска" Click="NavBoard_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3"/>
                    <Button Content="&#x1F4DD; Список задач" Click="NavList_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3"/>
                    <Button Content="&#x1F4CA; Статистика" Click="NavStats_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,12"/>

                    <TextBlock Text="Доски" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SidebarForeground}"
                               Margin="4,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding BoardNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Border Padding="8,6" CornerRadius="4" Cursor="Hand"
                                            Background="{DynamicResource ButtonBackground}"
                                            MouseLeftButtonDown="BoardItem_Clicked" Tag="{Binding}">
                                        <TextBlock Text="{Binding}" FontSize="13"
                                                   Foreground="{DynamicResource AppForeground}"
                                                   Margin="0,0,24,0"/>
                                    </Border>
                                    <Button Content="&#x2715;" HorizontalAlignment="Right" Padding="3,0"
                                            FontSize="10" Background="Transparent"
                                            Foreground="{DynamicResource DangerColor}"
                                            BorderThickness="0" Cursor="Hand" ToolTip="Удалить доску"
                                            Tag="{Binding}" Click="DeleteBoard_Click"
                                            Margin="0,0,4,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Новая доска" Click="NewBoard_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,6,0,12"/>

                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,12"/>

                    <Button Content="&#x1F345; Pomodoro" Click="NavPomodoro_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3"/>

                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,8,0,8"/>

                    <Button Content="&#x1F4C5; Спринты" Click="NavSprints_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3"/>
                    <Button Content="+ Новый спринт" Click="NewSprint_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,12"/>

                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,12,0,12"/>

                    <Button Content="&#x2699; Настройки" Click="NavSettings_Click"
                            Style="{StaticResource NavButtonStyle}" Margin="0,0,0,3"/>
                    <Button Content="&#x2753; Справка (F1)" Click="NavHelp_Click"
                            Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="MainContent"/>
    </Grid>
</Window>
