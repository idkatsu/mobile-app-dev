<Window x:Class="KanbanBoard.WPF.Views.TaskDialog"
        x:Name="TagChipsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Width="520" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel Margin="4">
            <TextBlock Text="Заголовок" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox" Height="30" FontSize="14" Margin="0,0,0,14"
                     Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource AppForeground}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <TextBlock Text="Описание" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
            <TextBox x:Name="DescBox" Height="80" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"
                     Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource AppForeground}"
                     BorderBrush="{DynamicResource BorderColor}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Приоритет" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="PriorityCombo" Width="130" Height="28">
                        <ComboBoxItem Content="Низкий" IsSelected="True"/>
                        <ComboBoxItem Content="Средний"/>
                        <ComboBoxItem Content="Высокий"/>
                        <ComboBoxItem Content="Критический"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Метка" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LabelCombo" Width="130" Height="28">
                        <ComboBoxItem Content="Нет" IsSelected="True"/>
                        <ComboBoxItem Content="Баг"/>
                        <ComboBoxItem Content="Фича"/>
                        <ComboBoxItem Content="Улучшение"/>
                        <ComboBoxItem Content="Исследование"/>
                        <ComboBoxItem Content="Дизайн"/>
                    </ComboBox>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Дедлайн" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
            <DatePicker x:Name="DueDatePicker" Margin="0,0,0,14"/>

            <TextBlock Text="Оценка помидоров" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Button Content="&#x2212;" Width="28" Height="28" Click="PomMinus_Click"/>
                <TextBlock x:Name="PomCount" Text="0" FontSize="16" Width="40" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource AppForeground}"/>
                <Button Content="+" Width="28" Height="28" Click="PomPlus_Click"/>
            </StackPanel>

            <TextBlock Text="Теги (через Enter)" FontSize="13" Foreground="{DynamicResource SidebarForeground}" Margin="0,0,0,4"/>
            <TextBox x:Name="TagBox" Height="28" FontSize="13" KeyDown="TagBox_KeyDown"
                     Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource AppForeground}"
                     BorderBrush="{DynamicResource BorderColor}" Margin="0,0,0,6"/>
            <ItemsControl x:Name="TagChipsControl" ItemsSource="{Binding ElementName=TagChipsDialog, Path=TagChips}" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8,3" Margin="0,0,6,4" CornerRadius="8"
                                Background="{DynamicResource ButtonBackground}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource AppForeground}"/>
                                <TextBlock Text=" &#x2715;" Cursor="Hand" Foreground="{DynamicResource DangerColor}"
                                           MouseLeftButtonDown="TagRemove_Click" Tag="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить" Click="Save_Click" Padding="16,8" Margin="0,0,8,0"
                        Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}" FontWeight="SemiBold"/>
                <Button Content="Отмена" Click="Cancel_Click" Padding="16,8"
                        Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
