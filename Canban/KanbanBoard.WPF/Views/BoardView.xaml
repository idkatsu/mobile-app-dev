<UserControl x:Class="KanbanBoard.WPF.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackground}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,10" Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="{Binding CurrentBoardName}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBox x:Name="SearchBox" Width="180" Height="30" FontSize="13"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource ButtonBackground}"
                             Foreground="{DynamicResource AppForeground}"
                             BorderBrush="{DynamicResource BorderColor}"
                             TextChanged="SearchBox_TextChanged"
                             Margin="0,0,8,0"/>
                    <Button Content="&#x2795; Задача" Click="AddTask_Click" Padding="12,6"
                            Background="{DynamicResource AccentColor}" Foreground="{DynamicResource AccentForeground}"
                            FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,0"
                Visibility="{Binding HasActiveSprint, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource ColumnBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SprintInfo}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="2" Value="{Binding SprintProgress, Mode=OneWay}" Maximum="100" Height="14"
                             Foreground="{DynamicResource AccentColor}" Background="{DynamicResource ButtonBackground}"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="{Binding SprintDaysText}" FontSize="11"
                           Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center"/>
                <CheckBox Grid.Column="5" Content="Только спринт" IsChecked="{Binding ShowSprintOnly}"
                          Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center"
                          FontSize="12" Margin="0,0,4,0"/>
                <Button Grid.Column="7" Content="Завершить" Click="CloseSprint_Click" Padding="10,3"
                        FontSize="11" Background="{DynamicResource DangerColor}" Foreground="White"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="16" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="270" Margin="0,0,12,0" Padding="10,10"
                                    Background="{DynamicResource ColumnBackground}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                    CornerRadius="8" AllowDrop="True"
                                    Drop="Column_Drop" DragOver="Column_DragOver">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <Border Width="4" Height="16" CornerRadius="2"
                                                Background="{Binding Color}" Margin="0,0,8,0"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppForeground}" VerticalAlignment="Center"/>
                                        <Button Content="&#x2715;" Click="DeleteColumn_Click" Tag="{Binding Id}"
                                                HorizontalAlignment="Right" Padding="4,2" FontSize="11"
                                                Background="Transparent" Foreground="{DynamicResource DangerColor}"
                                                BorderThickness="0" Cursor="Hand" ToolTip="Удалить колонку"
                                                Margin="4,0,0,0"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="12"
                                                   Foreground="{DynamicResource SidebarForeground}" VerticalAlignment="Center"
                                                   Margin="0,0,4,0">
                                            <Run Text="{Binding TaskCount, Mode=OneWay}"/>
                                            <Run Text="/"/>
                                            <Run Text="{Binding WipDisplay, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Tasks}" Margin="0,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="TaskCard" Margin="0,0,0,6" Padding="10,8"
                                                        Background="{DynamicResource CardBackground}"
                                                        BorderBrush="{DynamicResource BorderColor}"
                                                        BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                                        MouseLeftButtonDown="TaskCard_MouseDown"
                                                        MouseMove="TaskCard_MouseMove"
                                                        MouseLeftButtonUp="TaskCard_MouseUp"
                                                        Tag="{Binding}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Добавить в спринт" Click="AssignToSprint_Click" Tag="{Binding}"/>
                                                            <MenuItem Header="Убрать из спринта" Click="RemoveFromSprint_Click" Tag="{Binding}"/>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <DockPanel>
                                                        <Button Content="&#x2715;" Click="DeleteTask_Click" Tag="{Binding Id}"
                                                                DockPanel.Dock="Right" Padding="2,0" Margin="4,0,0,0"
                                                                FontSize="10" Background="Transparent"
                                                                Foreground="{DynamicResource DangerColor}"
                                                                BorderThickness="0" Cursor="Hand" ToolTip="Удалить задачу"/>
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <DockPanel>
                                                                <Border Width="4" Height="18" CornerRadius="2"
                                                                        Background="{Binding PriorityColor}"
                                                                        DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding Title}" FontSize="13"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource AppForeground}"
                                                                           FontWeight="SemiBold"/>
                                                            </DockPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                            <Border Padding="4,1" Margin="0,0,6,0" CornerRadius="4"
                                                                    Background="{DynamicResource AccentColor}" Visibility="{Binding HasSprint, Converter={StaticResource BoolToVisibility}}">
                                                                <TextBlock Text="S" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding LabelIcon}" FontSize="12"
                                                                       Margin="0,0,6,0" Foreground="{DynamicResource SidebarForeground}"/>
                                                                <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                                           Foreground="{DynamicResource SidebarForeground}" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding PomodoroText}" FontSize="11"
                                                                           Foreground="{DynamicResource AccentColor}" Margin="0,0,8,0"/>
                                                                <TextBlock Text="{Binding DeadlineText}" FontSize="11"
                                                                           Foreground="{Binding DeadlineBrush}"/>
                                                            </StackPanel>
                                                            <ItemsControl ItemsSource="{Binding TagChips}" Margin="0,4,0,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Padding="6,2" Margin="0,0,4,0" CornerRadius="8"
                                                                                Background="{DynamicResource ButtonBackground}">
                                                                            <TextBlock Text="{Binding}" FontSize="10"
                                                                                       Foreground="{DynamicResource SidebarForeground}"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="&#x2795;" Click="AddTaskToColumn_Click"
                                            Tag="{Binding Id}" HorizontalAlignment="Center"
                                            Padding="20,4" FontSize="13"
                                            Background="Transparent" Foreground="{DynamicResource SidebarForeground}"
                                            BorderThickness="0" Cursor="Hand"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
