<Window x:Class="KanbanBoard.WPF.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка" Width="500" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource AppBackground}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>
            <TextBlock Text="Справка" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}" Margin="0,0,0,16"/>

            <TextBlock Text="Горячие клавиши" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource AppForeground}" Margin="0,0,0,8"/>
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ctrl+N — Новая задача" Margin="0,0,0,6" FontSize="13" Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock Text="Ctrl+1/2/3 — Переключение видов" Margin="0,0,0,6" FontSize="13" Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock Text="P — Пауза/старт Pomodoro" Margin="0,0,0,6" FontSize="13" Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock Text="F1 — Справка" FontSize="13" Foreground="{DynamicResource AppForeground}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Техника Pomodoro" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource AppForeground}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,16" FontSize="13"
                       Text="Работайте 25 минут, затем сделайте перерыв 5 минут. После 4 помидоров — длинный перерыв 15 минут. Каждый помидор можно привязать к задаче."/>

            <TextBlock Text="WIP лимиты" FontWeight="SemiBold" FontSize="16"
                       Foreground="{DynamicResource AppForeground}" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource AppForeground}" FontSize="13"
                       Text="WIP (Work In Progress) лимит ограничивает количество задач в колонке. Если превышен — колонка подсвечивается красным. Поменяйте лимит через меню колонки."/>

            <Button Content="Закрыть" Click="Close_Click" Padding="16,8" Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource ButtonForeground}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
