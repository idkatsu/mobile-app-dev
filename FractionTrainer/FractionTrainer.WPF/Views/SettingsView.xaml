<UserControl x:Class="FractionTrainer.WPF.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FractionTrainer.WPF.Views"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="500" HorizontalAlignment="Left">

            <TextBlock Text="Настройки"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,20"/>

            <!-- Тема -->
            <TextBlock Text="Тема оформления:"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <RadioButton Content="Светлая"
                             IsChecked="{Binding SelectedTheme, Converter={StaticResource ThemeToBoolConverter}, ConverterParameter=Light}"
                             Foreground="{DynamicResource AppForeground}"
                             Margin="0,0,20,0"
                             Checked="LightTheme_Checked"/>
                <RadioButton Content="Тёмная"
                             IsChecked="{Binding SelectedTheme, Converter={StaticResource ThemeToBoolConverter}, ConverterParameter=Dark}"
                             Foreground="{DynamicResource AppForeground}"
                             Checked="DarkTheme_Checked"/>
            </StackPanel>

            <!-- Акцентный цвет -->
            <TextBlock Text="Акцентный цвет:"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,8"/>
            <WrapPanel Margin="0,0,0,20">
                <ItemsControl ItemsSource="{Binding AccentColors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="36" Height="36"
                                    CornerRadius="18"
                                    Margin="4"
                                    Cursor="Hand"
                                    Background="{Binding}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="2"
                                    MouseLeftButtonDown="ColorButton_Click"
                                    Tag="{Binding}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource AccentMatchConverter}">
                                                        <Binding Path="DataContext.SelectedAccentColor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="BorderThickness" Value="3"/>
                                                <Setter Property="BorderBrush" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>

            <!-- Сложность по умолчанию -->
            <TextBlock Text="Сложность по умолчанию:"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,8"/>
            <ComboBox SelectedIndex="0"
                      Background="{DynamicResource ButtonBackground}"
                      Foreground="{DynamicResource ButtonForeground}"
                      Margin="0,0,0,20"
                      SelectionChanged="DifficultyComboBox_SelectionChanged">
                <ComboBoxItem Content="Лёгкая"/>
                <ComboBoxItem Content="Средняя"/>
                <ComboBoxItem Content="Сложная"/>
            </ComboBox>

            <!-- Режим по умолчанию -->
            <TextBlock Text="Режим по умолчанию:"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,8"/>
            <StackPanel Margin="0,0,0,20">
                <RadioButton Content="Обучение"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource AppModeToBoolConverter}, ConverterParameter=Learning}"
                             Foreground="{DynamicResource AppForeground}"
                             Margin="0,0,0,5"
                             Checked="LearningMode_Checked"/>
                <RadioButton Content="Проверка знаний"
                             IsChecked="{Binding SelectedMode, Converter={StaticResource AppModeToBoolConverter}, ConverterParameter=Quiz}"
                             Foreground="{DynamicResource AppForeground}"
                             Checked="QuizMode_Checked"/>
            </StackPanel>

            <!-- Подсказки -->
            <CheckBox Content="Показывать подсказки"
                      IsChecked="{Binding ShowHints}"
                      Foreground="{DynamicResource AppForeground}"
                      Margin="0,0,0,20"/>

            <!-- Кнопки -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        Background="{DynamicResource AccentColor}"
                        Foreground="{DynamicResource AccentForeground}"
                        Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Сбросить к стандартным"
                        Command="{Binding ResetCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Padding="15,8"/>
            </StackPanel>

            <!-- Статус -->
            <TextBlock Text="{Binding StatusText}"
                       FontSize="14"
                       Foreground="Green"
                       Margin="0,0,0,10"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
