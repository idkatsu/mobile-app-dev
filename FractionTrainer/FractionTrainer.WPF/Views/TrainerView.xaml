<UserControl x:Class="FractionTrainer.WPF.Views.TrainerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FractionTrainer.WPF.Views"
             Background="{DynamicResource AppBackground}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>

        <!-- Основная область -->
        <Border Grid.Column="0" Margin="30" CornerRadius="12"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="ShakeTransform"/>
                </Grid.RenderTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок задачи -->
                <Border Grid.Row="0" Padding="0,24,0,8">
                    <TextBlock Text="{Binding TargetFractionText}"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Подсказка -->
                <TextBlock Grid.Row="1"
                           Text="{Binding QuestionText}"
                           FontSize="15"
                           Foreground="{DynamicResource SidebarForeground}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"/>

                <!-- === Row 2: Фигура ИЛИ варианты ответа === -->

                <!-- Фигура (круг/прямоугольник/треугольник) -->
                <Border Grid.Row="2"
                        Visibility="{Binding ShowShapeCanvas, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,8">
                    <Grid>
                        <views:FractionCircleControl
                            x:Name="CircleControl"
                            Width="300" Height="300"
                            TotalSectors="{Binding TotalSectors}"
                            SelectedSectors="{Binding SelectedSectors}"
                            SelectedSectorColor="{Binding SelectedSectorColor}"
                            DefaultSectorColor="{Binding DefaultSectorColor}"
                            Shape="{Binding CurrentShape}"
                            SectorClicked="CircleControl_SectorClicked"/>

                        <Border Background="#88000000" CornerRadius="80"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="120" Height="120"
                                Visibility="{Binding ShowCheckmark, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsHitTestVisible="False">
                            <TextBlock Text="&#x2713;"
                                       FontSize="64" FontWeight="Bold"
                                       Foreground="#4CAF50"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Варианты сравнения (когда нет фигуры) -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding CompareOptions}"
                              Visibility="{Binding ShowCompareOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="28,16" Margin="0,6" CornerRadius="10"
                                    Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" Cursor="Hand">
                                <RadioButton Content="{Binding}"
                                             GroupName="CompareGroup"
                                             FontSize="24" FontWeight="SemiBold"
                                             Foreground="{DynamicResource AppForeground}"
                                             HorizontalContentAlignment="Center"
                                             Checked="CompareOption_Checked"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Эквивалентные дроби (когда нет фигуры) -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding EquivalentOptions}"
                              Visibility="{Binding ShowEquivalentOptions, Converter={StaticResource BoolToVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="28,16" Margin="0,6" CornerRadius="10"
                                    Background="{DynamicResource SidebarBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1" Cursor="Hand">
                                <RadioButton Content="{Binding}"
                                             GroupName="EquivalentGroup"
                                             FontSize="24" FontWeight="SemiBold"
                                             Foreground="{DynamicResource AppForeground}"
                                             HorizontalContentAlignment="Center"
                                             Checked="EquivalentOption_Checked"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Найди пары -->
                <ItemsControl Grid.Row="2"
                              ItemsSource="{Binding PairCards}"
                              Visibility="{Binding ShowPairsBoard, Converter={StaticResource BoolToVisibilityConverter}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6" Width="140" Height="170"
                                    CornerRadius="10" BorderThickness="2"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="PairCard_MouseLeftDown"
                                    Tag="{Binding}"
                                    Padding="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SidebarBackground}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                <Setter Property="BorderBrush" Value="Green"/>
                                                <Setter Property="Background" Value="#E6FFE6"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#4A90D9"/>
                                                <Setter Property="Background" Value="#E6F0FF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <views:FractionCircleControl
                                        Width="110" Height="110"
                                        IsHitTestVisible="False"
                                        TotalSectors="{Binding TotalSectors}"
                                        Shape="{Binding Shape}"
                                        SelectedSectors="{Binding HighlightedSectors, Converter={StaticResource IntToHashSetConverter}}"
                                        SelectedSectorColor="{Binding SelectedSectorColor}"
                                        DefaultSectorColor="{Binding DefaultSectorColor}"/>
                                    <TextBlock Text="{Binding FractionText}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{DynamicResource AppForeground}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- === Row 3: Поля ввода под фигурой === -->

                <!-- Ввод числитель/знаменатель -->
                <Border Grid.Row="3"
                        Visibility="{Binding ShowFractionInput, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Padding="32,16" CornerRadius="12" Margin="0,8"
                        Background="{DynamicResource SidebarBackground}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Числитель" FontSize="13"
                                       Foreground="{DynamicResource SidebarForeground}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UserNumeratorInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" Height="40" FontSize="22" TextAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Background="{DynamicResource ButtonBackground}"
                                     Foreground="{DynamicResource AppForeground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"/>
                        </StackPanel>
                        <TextBlock Text="/" FontSize="36" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentColor}"
                                   VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <StackPanel>
                            <TextBlock Text="Знаменатель" FontSize="13"
                                       Foreground="{DynamicResource SidebarForeground}"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding UserDenominatorInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" Height="40" FontSize="22" TextAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Background="{DynamicResource ButtonBackground}"
                                     Foreground="{DynamicResource AppForeground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Дополнение до целого -->
                <Border Grid.Row="3"
                        Visibility="{Binding ShowCompleteToWhole, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Padding="32,16" CornerRadius="12" Margin="0,8"
                        Background="{DynamicResource SidebarBackground}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Не хватает" FontSize="18"
                                   Foreground="{DynamicResource SidebarForeground}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Text="{Binding CompleteToWholeInput, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" Height="40" FontSize="22" TextAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 Background="{DynamicResource ButtonBackground}"
                                 Foreground="{DynamicResource AppForeground}"
                                 BorderBrush="{DynamicResource BorderColor}"
                                 BorderThickness="1"/>
                        <TextBlock Text="долей" FontSize="18"
                                   Foreground="{DynamicResource SidebarForeground}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- === Row 4: Текущая дробь + обратная связь === -->
                <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,12,0,16">
                    <TextBlock Text="{Binding CurrentFractionText}"
                               FontSize="16"
                               Foreground="{DynamicResource SidebarForeground}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding FeedbackText}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{Binding FeedbackBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Боковая панель -->
        <Border Grid.Column="1"
                Background="{DynamicResource SidebarBackground}"
                Padding="16,20" Margin="0,30,30,30" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Настройки"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource SidebarForeground}"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Режим" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SidebarForeground}"
                           Margin="0,0,0,6"/>
                <StackPanel Margin="0,0,0,18">
                    <RadioButton Content="Обучение"
                                 IsChecked="{Binding SelectedMode, Converter={StaticResource AppModeToBoolConverter}, ConverterParameter=Learning}"
                                 Foreground="{DynamicResource SidebarForeground}"
                                 Margin="0,0,0,4"
                                 Checked="LearningMode_Checked"/>
                    <RadioButton Content="Проверка знаний"
                                 IsChecked="{Binding SelectedMode, Converter={StaticResource AppModeToBoolConverter}, ConverterParameter=Quiz}"
                                 Foreground="{DynamicResource SidebarForeground}"
                                 Checked="QuizMode_Checked"/>
                </StackPanel>

                <TextBlock Text="Сложность" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SidebarForeground}"
                           Margin="0,0,0,6"/>
                <ComboBox SelectedIndex="0"
                          Background="{DynamicResource ButtonBackground}"
                          Foreground="{DynamicResource ButtonForeground}"
                          Margin="0,0,0,18"
                          SelectionChanged="DifficultyComboBox_SelectionChanged">
                    <ComboBoxItem Content="Лёгкая"/>
                    <ComboBoxItem Content="Средняя"/>
                    <ComboBoxItem Content="Сложная"/>
                </ComboBox>

                <Button Content="Новая задача"
                        Command="{Binding NewPuzzleCommand}"
                        Background="{DynamicResource AccentColor}"
                        Foreground="{DynamicResource AccentForeground}"
                        Padding="10,10" Margin="0,0,0,6"
                        FontSize="14" FontWeight="SemiBold"/>

                <Button Content="Сбросить"
                        Command="{Binding ResetCommand}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Padding="10,10" Margin="0,0,0,6"
                        FontSize="14"/>

                <Button Content="Проверить"
                        Command="{Binding CheckAnswerCommand}"
                        Visibility="{Binding IsCheckVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="#4CAF50" Foreground="White"
                        Padding="10,10" Margin="0,0,0,6"
                        FontSize="14" FontWeight="SemiBold"/>

                <Button Content="Показать ответ"
                        Command="{Binding ShowAnswerCommand}"
                        Visibility="{Binding IsShowAnswerVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{DynamicResource ButtonBackground}"
                        Foreground="{DynamicResource ButtonForeground}"
                        Padding="10,10" Margin="0,0,0,18"
                        FontSize="14"/>

                <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,14"/>

                <TextBlock Text="{Binding ScoreText}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentColor}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
