<Window x:Class="FractionTrainer.WPF.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справка — Тренажёр собрать дробь"
        Width="550" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel>

            <TextBlock Text="Справка"
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,20"/>

            <!-- Горячие клавиши -->
            <TextBlock Text="Управление клавиатурой"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,10"/>

            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" Padding="10" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="F1" FontWeight="Bold" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Открыть эту справку" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl+N" FontWeight="Bold" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Новая задача" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl+R" FontWeight="Bold" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Сбросить выбор секторов" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl+T" FontWeight="Bold" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="Переключить тему" Foreground="{DynamicResource AppForeground}" Margin="0,0,0,5"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Escape" FontWeight="Bold" Foreground="{DynamicResource AppForeground}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="Сбросить выбор секторов" Foreground="{DynamicResource AppForeground}"/>
                </Grid>
            </Border>

            <!-- Как пользоваться -->
            <TextBlock Text="Как пользоваться тренажёром"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,10"/>

            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,20"
                       Text="Тренажёр помогает изучать дроби визуально. Круг делится на N равных частей (секторов), где N — знаменатель целевой дроби. Ваша задача — выбрать нужное количество секторов, чтобыNumerator секторов из N были закрашены.

В режиме «Обучение» можно посмотреть правильный ответ. В режиме «Проверка знаний» нужно выбрать секторы самостоятельно и нажать «Проверить».

Кнопки «– доля» и «+ доля» позволяют вручную изменить количество секторов для экспериментов."/>

            <!-- Параметры командной строки -->
            <TextBlock Text="Параметры командной строки"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="0,0,0,10"/>

            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" Padding="10" Margin="0,0,0,20">
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource AppForeground}"
                           FontFamily="Consolas" FontSize="13">
                    <Run Text="--mode [learning|quiz]" FontWeight="Bold"/><Run Text="  Режим работы"/><LineBreak/>
                    <Run Text="--difficulty [easy|medium|hard]" FontWeight="Bold"/><Run Text="  Уровень сложности"/><LineBreak/>
                    <Run Text="--count N" FontWeight="Bold"/><Run Text="  Количество задач (по умолчанию 5)"/><LineBreak/>
                    <Run Text="--show-answer" FontWeight="Bold"/><Run Text="  Автоматически показывать ответ (только learning)"/><LineBreak/>
                    <Run Text="--history" FontWeight="Bold"/><Run Text="  Вывести последние 10 сессий"/><LineBreak/>
                    <Run Text="--export-csv &lt;путь&gt;" FontWeight="Bold"/><Run Text="  Экспорт истории в CSV"/><LineBreak/>
                    <Run Text="--help / -h" FontWeight="Bold"/><Run Text="  Показать эту справку"/>
                </TextBlock>
            </Border>

            <!-- Кнопка закрыть -->
            <Button Content="Закрыть"
                    Click="CloseButton_Click"
                    Background="{DynamicResource AccentColor}"
                    Foreground="{DynamicResource AccentForeground}"
                    Padding="20,8"
                    HorizontalAlignment="Center"/>

        </StackPanel>
    </ScrollViewer>
</Window>
