<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AppBackground" Color="#16161E"/>
    <SolidColorBrush x:Key="AppForeground" Color="#E0E0F0"/>
    <SolidColorBrush x:Key="SidebarBackground" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="SidebarForeground" Color="#A0A0C0"/>
    <SolidColorBrush x:Key="CardBackground" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#2A2A3E"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#C0C0E0"/>
    <SolidColorBrush x:Key="AccentColor" Color="#6B9BF7"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#333350"/>

</ResourceDictionary>
